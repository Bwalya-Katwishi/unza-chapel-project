# Local development (npm run db:start)
DATABASE_URL="postgresql://unza_chapel@127.0.0.1:55432/unza_chapel_portal?schema=public"

# Production / Vercel — use Neon (or similar). Must include sslmode=require.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Local:
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Production (Vercel):
# AUTH_URL="https://your-app.vercel.app"
# NEXTAUTH_URL="https://your-app.vercel.app"

APP_NAME="UNZA Chapel & Community Portal"
APP_TIMEZONE="Africa/Lusaka"
CURRENCY="ZMW"

SMTP_HOST=""

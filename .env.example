# Docker Compose alternative (docker compose up -d)
# DATABASE_URL="postgresql://unza_chapel:unza_chapel_dev_password@localhost:5432/unza_chapel_portal?schema=public"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

APP_NAME="UNZA Chapel & Community Portal"
APP_TIMEZONE="Africa/Lusaka"
CURRENCY="ZMW"

SMTP_HOST=""
SMTP_PORT="587"
